# ============================================
# 超星 OAuth 登录
# ============================================
# 超星应用 AppID
CHAOXING_APPID=your-appid
# 超星应用 Secret（对应超星 APPKEY，仅服务端使用）
CHAOXING_SECRET=your-secret
# 允许登录的机构 FID 白名单，逗号分隔多个（可带空格），两种写法决定登录行为：
# 1) 只写 FID：登录界面只有一个按钮，机构由回调按此顺序静默轮询确定
#    CHAOXING_FIDS=1385, 344402, 110
# 2) 写成 fid:机构名称：登录界面显示机构下拉框，登录严格限定在所选机构下，
#    账号不属于该机构即报错，不会改判到别的机构
#    CHAOXING_FIDS=1385:超星集团, 344402:课程项目, 110:测试
CHAOXING_FIDS=your-fid
# 超星后台登记的应用回调地址
CHAOXING_REDIRECT_URI=https://your-domain/api/auth/callback/chaoxing

# ============================================
# Supabase（Coze 实例化后自动注入，本地开发需手填）
# ============================================
# Supabase 项目地址
COZE_SUPABASE_URL=https://your-project.supabase.co
# 匿名公钥，会下发到浏览器
COZE_SUPABASE_ANON_KEY=your-anon-key
# service role 密钥，可绕过 RLS，仅服务端使用，切勿下发到浏览器或提交进仓库
COZE_SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ============================================
# 运行环境（可选，Coze 部署时自动注入）
# ============================================
# 公网域名，反向代理下用于拼出真实回调 origin；留空则回落到请求头推断
COZE_PROJECT_DOMAIN_DEFAULT=
# 置为 PROD 时给 Session Cookie 打上 Secure；本地 http 调试请留空
COZE_PROJECT_ENV=

# ============================================
# 附件存储 / 下载（可选，均有合理默认值）
# ============================================
# Supabase Storage bucket 名。默认 bidding-attachments；
# 生产若用独立桶（如 bidding-attachments-prod）需显式指定，并提前在控制台建好该私有 bucket。
STORAGE_BUCKET=bidding-attachments
# 超星源文件单次下载大小上限（MB）。默认 250（已覆盖观测到的 195MB 源文件）。
CHAOXING_MAX_FILE_MB=250
# 对象存储单文件转存上限（MB）。超过则自动降级为「超星直链」实时签名下载，
# 避免触发 Supabase 单文件约 50MB 的上传上限并防止 Node 堆 OOM。默认 45。
STORAGE_MAX_FILE_MB=45

# ============================================
# 第三方接口推送
# ============================================
# 第三方任务推送接口 /api/external/push 的访问 token
EXTERNAL_PUSH_TOKEN=dev-push-token-change-me

# 招投标截图第三方推送接口 /api/external/bidding-screenshots/push 与超星项目外出推送
# /api/external/chaoxing/push 均按无鉴权设计，入口仅通过公网 HTTPS + 业务幂等键控制。
# 如后续需要限制来源，可在反向代理 / WAF 层加出口 IP 白名单。

# 超星表单推送接口按无鉴权设计；如需额外限制，可后续通过出口 IP 白名单控制
# EXTERNAL_CHAOXING_IP_WHITELIST=1.2.3.4,5.6.7.8
